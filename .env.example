# Cloudflare provisioning & deploy (never commit .env or wrangler.jsonc)
CF_API_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_ZONE_ID=

# Zero Trust Access
CF_ACCESS_EMAIL=you@example.com
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=
CF_INGEST_ACCESS_AUD=
CF_INGEST_ACCESS_CLIENT_ID=

# Worker Secrets (upload via `wrangler secret put`)
HEALTHCHECKS_API_KEY=
INGEST_BEARER_TOKEN=
CF_ANALYTICS_TOKEN=

# Optional customization (JSON strings / display overrides)
DASHBOARD_NAME="Edge Ops"
PRIMARY_NODE_ID=vps
PROBE_TARGETS_JSON='[{"id":"site-apex","label":"example.com","url":"https://example.com/"},{"id":"api-health","label":"api.example.com/api/health","url":"https://api.example.com/api/health","parseJson":true}]'
DASHBOARD_LINKS_JSON='[{"label":"Healthchecks","url":"https://healthchecks.io/projects/"},{"label":"Cloudflare","url":"https://dash.cloudflare.com"}]'
HEARTBEAT_NODES_JSON='{"vps":"Primary host","remote-probe":"Remote probe"}'
AUX_CONTAINERS_LABEL="Aux containers"
BACKUP_LABELS_JSON='{"primary":"Off-site backup","app":"App snapshot","sync":"Remote sync"}'

# Local dev only (keep unset in production)
LOCAL_DEV_BYPASS=

# D1 database
D1_DATABASE_ID=
