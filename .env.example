# Copy to .env (chmod 600). Never commit .env.

# Cloudflare Zero Trust Tunnel token (from Zero Trust -> Networks -> Tunnels -> malex-dashboard)
TUNNEL_TOKEN=

# Comma-separated allowed Host headers for Homepage
HOMEPAGE_ALLOWED_HOSTS=dashboard.malex.tech

# Optional Beszel Hub public URL (e.g. https://metrics.malex.tech or http://127.0.0.1:8090)
BESZEL_APP_URL=https://metrics.malex.tech

# Azure provisioning defaults (used by scripts/provision-azure.sh)
AZURE_LOCATION=germanywestcentral
AZURE_RG=rg-malex-dashboard
AZURE_VM_NAME=malex-dashboard
AZURE_ADMIN_USER=azureuser
